{
  "name": "superslotstudio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "demo": "npm run build && node scripts/serve-demo.mjs",
    "evidence:recovery": "tsc -p tsconfig.json && node dist/tools/evidence/recovery-cli.js",
    "studio": "npm run build && node dist/tools/studio/cli.js",
    "studio:fixtures": "npm run build && node dist/tools/studio/cli.js cues --all",
    "test": "rm -rf dist && npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
